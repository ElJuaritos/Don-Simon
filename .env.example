# Copia este archivo a .env.local y llena los valores. .env.local NO se sube al repositorio.

# URL pública del sitio (para los enlaces de regreso de Stripe).
# Producción: https://donsimonshoes.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos. Vacía = base local PGlite en .data/pglite (con datos de ejemplo).
# En producción: cadena de conexión de Supabase (Settings → Database → Connection string, modo "Transaction").
DATABASE_URL=

# Acceso al panel /admin. Usa una contraseña larga y única.
ADMIN_PASSWORD=cambia-esta-contrasena
# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Stripe (llaves de PRUEBA para desarrollo: sk_test_...). Vacías = modo demo sin cobro.
STRIPE_SECRET_KEY=
# Se obtiene con `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_...)
STRIPE_WEBHOOK_SECRET=
